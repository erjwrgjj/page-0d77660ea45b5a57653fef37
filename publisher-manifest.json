r(--ink-soft);letter-spacing:0}\n  .annual{font-size:.88rem;color:var(--violet-deep);margin:-6px 0 12px}\n  .plan ul{list-style:none;padding:0;margin:0;border-top:1px dashed var(--line);padding-top:14px}\n  .plan li{display:flex;gap:10px;align-items:flex-start;font-size:.95rem;padding:5px 0;color:var(--ink-soft)}\n  .plan li::before{content:\"\";flex:0 0 auto;width:8px;height:8px;margin-top:.62em;background:var(--violet);display:block}\n  .note{font-size:.86rem;color:var(--ink-soft);border-top:1px solid var(--line);padding-top:14px;margin-top:6px}\n\n  /* details FAQ */\n  details.q{background:#fff;border:1px solid var(--line);border-left:var(--edge) solid var(--paper-2);margin-bottom:10px}\n  details.q[open]{border-left-color:var(--violet)}\n  details.q summary{cursor:pointer;list-style:none;padding:16px 20px;font-weight:700;font-size:1rem;position:relative;padding-right:48px}\n  details.q summary::-webkit-details-marker{display:none}\n  details.q summary::after{content:\"+\";position:absolute;right:18px;top:50%;transform:translateY(-50%);color:var(--violet);font-size:1.35rem;font-weight:400;line-height:1}\n  details.q[open] summary::after{content:\"–\"}\n  details.q .a{padding:0 20px 18px;color:var(--ink-soft);font-size:.95rem}\n  details.q .a p{margin:0 0 .7em}\n  details.q .a p:last-child{margin-bottom:0}\n\n  .steps{counter-reset:s;list-style:none;padding:0;margin:0}\n  .steps li{counter-increment:s;position:relative;padding:0 0 20px 52px;border-left:1px solid var(--line);margin-left:16px}\n  .steps li:last-child{border-left-color:transparent;padding-bottom:0}\n  .steps li::before{content:counter(s,decimal-leading-zero);position:absolute;left:-17px;top:-2px;width:33px;height:33px;line-height:31px;text-align:center;background:var(--violet);color:#fff;font-size:12px;font-weight:700;letter-spacing:.03em}\n  .steps b{display:block;margin-bottom:.2em}\n  .steps p{margin:0;font-size:.94rem;color:var(--ink-soft)}\n\n  .foot{margin-top:64px;background:#1b1a20;color:#a9a6bb;padding:34px 0;font-size:.88rem}\n  .foot .wrap{display:flex;flex-wrap:wrap;gap:14px 28px;justify-content:space-between;align-items:baseline}\n  .foot a{color:#c9b3ff;border-bottom-color:rgba(201,179,255,.4)}\n  .foot strong{color:#e9e7f2;letter-spacing:.12em;font-size:.8rem;text-transform:uppercase}\n\n  /* 底部固定式文字导航 */\n  .dock{position:fixed;left:0;right:0;bottom:0;z-index:20;background:rgba(27,26,32,.97);border-top:var(--edge) solid var(--violet)}\n  .dock ul{max-width:1080px;margin:0 auto;padding:0 10px;list-style:none;display:flex;flex-wrap:nowrap;justify-content:space-between}\n  .dock li{flex:1 1 auto;margin:0}\n  .dock a{display:block;text-align:center;padding:14px 4px;color:#d7d4e6;font-size:.82rem;letter-spacing:.06em;border-bottom:0;white-space:nowrap}\n  .dock a:hover{color:#fff;background:rgba(107,47,240,.28);border-bottom:0}\n\n  @media (max-width:820px){\n    .hero-top{grid-template-columns:1fr}\n    .band-2 .two-col{grid-template-columns:1fr;gap:20px}\n    .cols-2{grid-template-columns:1fr}\n    .stat-strip{grid-template-columns:1fr}\n  }\n  @media (max-width:520px){\n    body{font-size:15px;padding-bottom:70px}\n    .band{padding:26px 0}\n    .band-1{padding-top:38px}\n    .price{font-size:1.6rem}\n    .dock a{font-size:.68rem;padding:12px 2px;letter-spacing:.02em}\n    .dock ul{padding:0 4px}\n    .plan{padding:20px 18px 18px}\n    .mark{padding:18px 18px}\n  }\n</style><main>\n\n  <div class=\"band band-1\">\n    <div class=\"wrap\">\n      <div class=\"hero-top\">\n        <div>\n          <p class=\"eyebrow\">Micro · 使用说明与订阅方案</p>\n          <h1>Micro<br><span class=\"thin\">把网络这件事，拆开来看。</span></h1>\n          <p class=\"lead\">我们不太愿意用形容词来说服你。这份页面把 Micro 的订阅结构、客户端的操作顺序、以及那些经常被含糊过去的问题，一条条写下来。你可以从任意一段读起，也可以在底部导航里跳到最关心的部分。</p>\n        </div>\n        <div class=\"hero-note\">\n          <p><strong>先说明白一件事：</strong>Micro 是一个需要下载客户端、选择方案、按自己的设备数量使用的工具。没有哪一步是隐藏的，也没有哪一步需要猜。</p>\n          <p>下面所有价格与权益，都以本页展示的文字为准。</p>\n        </div>\n      </div>\n\n      <div class=\"stat-strip\">\n        <div><b>3</b><span>档订阅方案</span></div>\n        <div><b>1</b><span>套客户端操作顺序</span></div>\n        <div><b>9</b><span>条常见问题逐条作答</span></div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"band band-2\">\n    <div class=\"wrap\">\n      <div class=\"two-col\">\n        <div>\n          <p class=\"eyebrow\">写在前面</p>\n          <h2>我们选择用“说明书”的姿态，而不是宣传页的姿态。</h2>\n          <p class=\"muted\">一份好的说明书不会承诺你从未验过的东西。它只告诉你：这里有哪些零件、它们怎么咬合、出问题时先检查哪一颗螺丝。Micro 想做的，就是这样一份东西。</p>\n        </div>\n        <div>\n          <p class=\"muted\">所以这一页里没有“秒开”“无感”“一键”这类词。有的是：方案之间差在哪里、你该按什么顺序操作客户端、订阅到期之后会发生什么、退款这件事我们怎么处理。这些话写出来可能不够热闹，但它足够诚实。</p>\n          <p class=\"muted\">如果你读完仍然有疑问，FAQ 里那九个问题，是按我们收到最多的问题排序的。</p>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <section class=\"block wrap\" id=\"how\">\n    <div class=\"sec-head\">\n      <h2>使用顺序：四步，别跳</h2>\n      <p>把顺序做对，后面就很少需要回头修。</p>\n    </div>\n\n    <ol class=\"steps\">\n      <li>\n        <b>先确认你要用什么设备</b>\n        <p>数一下：手机几台、笔记本几台、平板要不要算。这个数字决定了你该看哪一档方案，而不是反过来先挑价格再看设备数——那是最容易返工的顺序。</p>\n      </li>\n      <li>\n        <b>选方案并完成订阅</b>\n        <p>对照下面的三个档位，看流量上限与设备上限两条硬线。两条都够用，就选便宜的那一档；其中任意一条不够，往上一档走。</p>\n      </li>\n      <li>\n        <b>获取客户端并按页面说明安装</b>\n        <p>订阅完成后你会得到进入客户端的入口。安装时按页面给出的步骤来，不要从第三方站点下载安装包——这一点在任何工具上都成立，与是否使用 Micro 无关。</p>\n      </li>\n      <li>\n        <b>首次使用后回头核一遍数字</b>\n        <p>用上一两天，再回到账户里看看流量消耗的速度是否和你的预期一致。如果明显超出预期，先检查是不是有设备在后台持续占用，再决定是否升档。</p>\n      </li>\n    </ol>\n  </section>\n\n  <section class=\"block wrap\" id=\"plans\">\n    <div class=\"sec-head\">\n      <h2>三档方案，差在两条硬线上</h2>\n      <p>流量上限与同时在线设备数，是唯一需要真正比较的两个数字。</p>\n    </div>\n\n    <article class=\"plan\">\n      <div class=\"plan-top\">\n        <h3>基础版</h3>\n        <div class=\"price\">¥15<small> / 月</small></div>\n      </div>\n      <p class=\"annual\">按年付仅需 ¥150 / 年</p>\n      <ul>\n        <li>每月 100GB 极速流量</li>\n        <li>支持 3 台设备同时在线</li>\n        <li>解锁基础流媒体</li>\n        <li>普通线路节点池</li>\n      </ul>\n      <p class=\"note\">适合一台手机加一台电脑的日常组合。如果你只在固定时段用，这一档通常够。</p>\n    </article>\n\n    <article class=\"plan is-featured\">\n      <div class=\"plan-top\">\n        <h3>旗舰版<span class=\"tag\">常用之选</span></h3>\n        <div class=\"price\">¥35<small> / 月</small></div>\n      </div>\n      <p class=\"annual\">按年付仅需 ¥350 / 年</p>\n      <ul>\n        <li>每月 300GB 极速流量</li>\n        <li>支持 5 台设备同时在线</li>\n        <li>全节点原生流媒体解锁</li>\n        <li>IPLC 专线游戏加速优化</li>\n        <li>7x24 优先工单支持</li>\n      </ul>\n      <p class=\"note\">设备数从 3 到 5，流量从 100GB 到 300GB，是这一档最实在的两处变化。多出来的支持通道，适合对响应时间有要求的人。</p>\n    </article>\n\n    <article class=\"plan\">\n      <div class=\"plan-top\">\n        <h3>团队版</h3>\n        <div class=\"price\">¥85<small> / 月</small></div>\n      </div>\n      <p class=\"annual\">按年付仅需 ¥850 / 年</p>\n      <ul>\n        <li>每月 1000GB 极速流量</li>\n        <li>支持 20 台设备同时在线</li>\n        <li>VIP 专属高带宽节点</li>\n        <li>支持企业定制路由</li>\n        <li>专属客户经理服务</li>\n      </ul>\n      <p class=\"note\">按人头算，20 台设备是分水岭。如果你们是几个人的小组，先把同时在线的高峰数字数清楚再决定。</p>\n    </article>\n\n    <p class=\"note\">以上价格与权益构成本页的全部方案信息；未在本页列出的内容，请不要默认它存在。</p>\n  </section>\n\n  <section class=\"block wrap\" id=\"clients\">\n    <div class=\"sec-head\">\n      <h2>客户端：装在哪里，注意什么</h2>\n      <p>我们只描述流程与注意事项，不提供来路不明的安装包。</p>\n    </div>\n\n    <div class=\"cols-2\">\n      <div class=\"mark\">\n        <h3>移动设备</h3>\n        <p>手机上装客户端时，最重要的是别装错来源。安装完成后先登录，再检查一次账户里显示的在线设备数量，确认没有多出来的那一台。</p>\n        <dl>\n          <dt>安装位置</dt><dd>通过订阅完成后给出的官方入口获取</dd>\n          <dt>首次检查</dt><dd>设备列表是否与你实际使用的一致</dd>\n        </dl>\n      </div>\n\n      <div class=\"mark\">\n        <h3>桌面设备</h3>\n        <p>笔记本与台式机上的客户端，安装后建议先跑一次完整的功能核对：连接、断开、再连接。顺序走通了，后面出问题更容易定位。</p>\n        <dl>\n          <dt>推荐顺序</dt><dd>先装好、再登录、最后才调整设置</dd>\n          <dt>常见误区</dt><dd>一开始就改一堆参数，出问题无从比较</dd>\n        </dl>\n      </div>\n\n      <div class=\"mark\">\n        <h3>多设备并存</h3>\n        <p>同时在线数与方案绑定。旗舰版是 5 台、团队版是 20 台，超出时会有一台被挤下线。这不是故障，是额度在起作用。</p>\n        <dl>\n          <dt>处理方式</dt><dd>先确认哪台设备可以退出，再决定是否升档</dd>\n          <dt>不建议</dt><dd>为了凑数频繁切换登录，容易把问题搅乱</dd>\n        </dl>\n      </div>\n\n      <div class=\"mark\">\n        <h3>账户与订阅状态</h3>\n        <p>订阅、流量使用情况、设备数都在账户里能看到。遇到说不清的问题时，先把账户页截图，再描述现象，沟通效率会高很多。</p>\n        <dl>\n          <dt>先看哪里</dt><dd>账户页的流量与设备两块</dd>\n          <dt>再说问题</dt><dd>描述“什么时候、哪台设备、什么现象”</dd>\n        </dl>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"block wrap\" id=\"faq\">\n    <div class=\"sec-head\">\n      <h2>常见问题：九个，按被问到的频率排</h2>\n      <p>点开任意一条，答案就在下面。</p>\n    </div>\n\n    <details class=\"q\">\n      <summary>我该怎么在三个方案里选一个？</summary>\n      <div class=\"a\">\n        <p>只看两个数字：每月流量上限和同时在线设备数。基础版是 100GB 与 3 台，旗舰版是 300GB 与 5 台，团队版是 1000GB 与 20 台。两个数字都够用，就停在便宜的那一档。</p>\n      </div>\n    </details>\n\n    <details class=\"q\">\n      <summary>年付和月付有区别吗，除了价格？</summary>\n      <div class=\"a\">\n        <p>本页展示的年付价格分别是 ¥150、¥350、¥850。除此之外，方案包含的流量与设备数不因付费周期而改变。是否年付，取决于你打算用多久，而不是能多用多少。</p>\n      </div>\n    </details>\n\n    <details class=\"q\">\n      <summary>同时在线设备数超了会怎样？</summary>\n      <div class=\"a\">\n        <p>额度是有上限的，超出时会有设备被挤下线。这不是使用异常。处理办法只有两个：让某台设备退出，或者升到设备数更高的方案。</p>\n      </div>\n    </details>\n\n    <details class=\"q\">\n      <summary>装客户端时最容易犯的错是什么？</summary>\n      <div class=\"a\">\n        <p>从非官方来源获取安装包，以及一上来就改大量参数。前者的风险不用多说；后者的问题是，你失去了一个已知可用的对照状态，之后任何现象都无法判断是自己改的，还是本来就有的。</p>\n      </div>\n    </details>\n\n    <details class=\"q\">\n      <summary>流量用完了会立刻断掉吗？</summary>\n      <div class=\"a\">\n        <p>流量按方案上限计算，用满后当月可用的额度就到底了。因此我们建议：用到月中时回账户看一眼消耗速度，比月底才发现不够用更从容。</p>\n      </div>\n    </details>\n\n    <details class=\"q\">\n      <summary>“基础流媒体解锁”和“全节点原生流媒体解锁”差在哪？</summary>\n      <div class=\"a\">\n        <p>差别在覆盖范围：基础版解锁基础流媒体；旗舰版与团队版为全节点原生流媒体解锁。如果你的使用以流媒体为主，这一条比多出来的设备数更值得关注。</p>\n      </div>\n    </details>\n\n    <details class=\"q\">\n      <summary>遇到问题应该先做什么？</summary>\n      <div class=\"a\">\n        <p>先看账户页的流量与设备两块，确认不是额度导致的。如果数值正常，再记录现象：哪台设备、什么时间、操作到哪一步。带着这三样去问，比只说“连不上”有用得多。</p>\n      </div>\n    </details>\n\n    <details class=\"q\">\n      <summary>团队版的定制路由，我需要吗？</summary>\n      <div class=\"a\">\n        <p>如果你的场景只是几个人各自上网，多半不需要。定制路由面向的是有明确内部网络安排的使用方。没有具体需求时，旗舰版往往是更简单的一步。</p>\n      </div>\n    </details>\n\n    <details class=\"q\">\n      <summary>这一页没有写到的信息，算数吗？</summary>\n      <div class=\"a\">\n        <p>不算。本页只陈述我们已经写出来的内容：三档方案、各自的价格与权益、客户端的操作顺序与注意事项、以及上面这些问答。页面未提及的事情，请不要当作已承诺的内容。</p>\n      </div>\n    </details>\n  </section>\n\n  <section class=\"block wrap\">\n    <div class=\"sec-head\">\n      <h2>最后一句，关于耐心</h2>\n    </div>\n    <div class=\"two-col\">\n      <div class=\"mark\">\n        <h3>先读，再买</h3>\n        <p>这一页足够长，长到你能在付款之前把方案差别看清。我们宁可你多花五分钟读，也不想你在第一个月就发现设备数不够。</p>\n      </div>\n      <div class=\"mark\">\n        <h3>先核，再问</h3>\n        <p>大部分“连不上”其实能在账户页找到答案。养成先看数字、再描述现象的习惯，你会发现沟通成本低得惊人。</p>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<div class=\"foot\">\n  <div class=\"wrap\">\n    <strong>Micro</strong>\n    <span>本页为 Micro 的方案与使用说明，价格与权益以本页文字为准。</span>\n    <a href=\"#how\">回到使用顺序</a>\n  </div>\n</div>\n\n<nav class=\"dock\" aria-label=\"页面内导航\">\n  <ul>\n    <li><a href=\"#how\">使用顺序</a></li>\n    <li><a href=\"#plans\">方案对比</a></li>\n    <li><a href=\"#clients\">客户端</a></li>\n    <li><a href=\"#faq\">常见问题</a></li>\n    <li><a href=\"#top\">页首</a></li>\n  </ul>\n</nav>",
