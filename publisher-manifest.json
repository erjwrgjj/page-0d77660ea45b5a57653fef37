          "body": "<style>\n  :root{--ink:#1b1a20;--ink-soft:#4a4854;--paper:#f1f1f4;--paper-2:#e7e7ec;--line:#d3d3da;--violet:#6b2ff0;--violet-soft:#efe8ff;--violet-deep:#43139e;--edge:4px}\n  *{box-sizing:border-box}\n  html{-webkit-text-size-adjust:100%}\n  body{margin:0;background:var(--paper);color:var(--ink);font-family:\"Helvetica Neue\",\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",sans-serif;font-size:16px;line-height:1.75;letter-spacing:.01em;padding-bottom:76px}\n  a{color:var(--violet-deep);text-decoration:none;border-bottom:1px solid rgba(107,47,240,.35)}\n  a:hover{color:var(--violet);border-bottom-color:var(--violet)}\n  h1,h2,h3,h4{margin:0;line-height:1.3;font-weight:700;letter-spacing:-.01em}\n  p{margin:0 0 1em}\n  ul{margin:0 0 1em;padding-left:1.15em}\n  li{margin:.35em 0}\n  .wrap{max-width:1080px;margin:0 auto;padding:0 22px}\n  .eyebrow{font-size:12px;letter-spacing:.22em;text-transform:uppercase;color:var(--violet-deep);font-weight:700}\n  .lead{font-size:1.06rem;color:var(--ink-soft)}\n\n  /* 首屏：全宽色带分层堆叠 */\n  .band{padding:34px 0}\n  .band-1{background:var(--paper-2);padding-top:52px}\n  .band-2{background:#1b1a20;color:#e9e7f2;border-top:var(--edge) solid var(--violet)}\n  .band-2 .eyebrow{color:#b79cff}\n  .band-2 a{color:#c9b3ff;border-bottom-color:rgba(201,179,255,.4)}\n  .band-3{background:var(--violet-soft)}\n  .band-4{background:#fbfbfc}\n\n  .hero-top{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);gap:34px;align-items:end}\n  h1{font-size:clamp(2.5rem,7vw,4.6rem);letter-spacing:-.035em;margin:.18em 0 .3em}\n  h1 .thin{font-weight:300;color:var(--ink-soft)}\n  .hero-note{border-left:var(--edge) solid var(--violet);padding:2px 0 2px 16px;font-size:.95rem;color:var(--ink-soft)}\n  .hero-note strong{color:var(--ink)}\n\n  .stat-strip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:var(--line);border:1px solid var(--line);margin-top:38px}\n  .stat-strip div{background:var(--pap